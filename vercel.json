{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "trailingSlash": false,
  "functions": {
    "api/sign/*.js": {
      "includeFiles": "assets/fonts/**"
    }
  },
  "redirects": [
    {
      "source": "/biz",
      "destination": "/biz/",
      "permanent": false
    },
    {
      "source": "/hr-dashboard.html",
      "destination": "/hr/",
      "permanent": false
    },
    {
      "source": "/hr-applicants.html",
      "destination": "/hr/applicants.html",
      "permanent": false
    },
    {
      "source": "/hr-ceo-review.html",
      "destination": "/hr/ceo-review.html",
      "permanent": false
    },
    {
      "source": "/hr-offer.html",
      "destination": "/hr/offer.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hr",
      "destination": "/hr/index.html"
    },
    {
      "source": "/sales",
      "destination": "/sales/index.html"
    },
    {
      "source": "/sales/companies",
      "destination": "/sales/companies.html"
    },
    {
      "source": "/sales/attack",
      "destination": "/sales/attack.html"
    },
    {
      "source": "/sales/clicks",
      "destination": "/sales/clicks.html"
    },
    {
      "source": "/sales/analytics",
      "destination": "/sales/analytics.html"
    },
    {
      "source": "/sales/templates",
      "destination": "/sales/templates.html"
    },
    {
      "source": "/sales/campaigns",
      "destination": "/sales/campaigns.html"
    },
    {
      "source": "/r/:token",
      "destination": "/api/sales/r?t=:token"
    },
    {
      "source": "/pc",
      "destination": "/device-consent.html"
    },
    {
      "source": "/ext/updates.xml",
      "destination": "/api/ext?f=updates.xml"
    },
    {
      "source": "/ext/eight-ext.crx",
      "destination": "/api/ext?f=eight-ext.crx"
    }
  ],
  "headers": [
    {
      "source": "/(js|css)/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/escalate",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/analytics/sync",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/onboarding",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/devices",
      "schedule": "20 18 * * *"
    },
    {
      "path": "/api/cron/tasks",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/cron/task-events",
      "schedule": "10 21 * * *"
    },
    {
      "path": "/api/cron/hr-interviews",
      "schedule": "20 * * * *"
    }
  ]
}
