{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "trailingSlash": false,
  "functions": {
    "api/sign/*.js": {
      "includeFiles": "assets/fonts/**"
    }
  },
  "redirects": [
    {
      "source": "/biz",
      "destination": "/biz/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pc",
      "destination": "/device-consent.html"
    },
    {
      "source": "/ext/updates.xml",
      "destination": "/api/ext?f=updates.xml"
    },
    {
      "source": "/ext/eight-ext.crx",
      "destination": "/api/ext?f=eight-ext.crx"
    }
  ],
  "headers": [
    {
      "source": "/(js|css)/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/escalate",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/analytics/sync",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/onboarding",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/devices",
      "schedule": "20 18 * * *"
    },
    {
      "path": "/api/cron/tasks",
      "schedule": "10 15 * * *"
    }
  ]
}
