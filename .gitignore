# ===== 自社経理運用ツール 固有ルール =====

# 機密情報（MFアクセストークン等）
.env
.env.*
!.env.local.example
!.env.example

# ローカル運用データ（業務データ・個人情報を含むためgit追跡禁止）
data/
backup/

# Claude Code ローカル設定・実行時ファイル
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock

# OS生成ファイル
Thumbs.db
.DS_Store
desktop.ini

# エディタ
.vscode/
.idea/
*.swp
*~

# ===== Node / フロントエンド一般（GitHub標準テンプレート由来）=====

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage / test
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Vercel
.vercel/

# Caches
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache
.vite/

# Build output
dist
.output
*.tsbuildinfo

# Misc
*.tgz
.node_repl_history

# 画面テストのスクリーンショット
#
# テストはリポジトリ直下で動かすので、書き出し先を相対パスにすると
# ここに溜まる。Vercel は直下のファイルをログイン無しで配るので、
# 人事や端末管理の画面の写しが公開されてしまう。
# 書き出し先はスクラッチに置くこと。念のためここでも止める
/*.png
