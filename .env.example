# =====================================================================
# Vercel / ローカル開発の環境変数テンプレート
# 本番値は Vercel の Project Settings → Environment Variables に設定。
# このファイル(.env.example) は GitHub にコミット可。
# 実値ファイル(.env.local) は .gitignore で除外。
# =====================================================================

# ---------------- Supabase ----------------
# Project Settings → API から取得
SUPABASE_URL=https://vuqzsuhwuznclqxxtgfn.supabase.co
SUPABASE_ANON_KEY=eyJ...           # クライアント側でも使うpublishable key（Settings→API の anon public）
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # サーバ専用（RLSをbypass、絶対にクライアントへ出さない）

# ---------------- Anthropic Claude API ----------------
# https://console.anthropic.com/ → API Keys
# 重要: 「学習に使わない/ゼロ保持」設定を有効にしたキー/組織を使用すること
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------- 初期セットアップ（/api/admin/setup 用） ----------------
# ランダムな長い文字列。設定時のみ setup エンドポイントが有効になる。
# 初期投入が終わったら削除して setup を無効化する運用を推奨。
SETUP_SECRET=

# ---------------- MF連動（Phase3・任意） ----------------
# MF Cloud API のベースURL。未設定の間は承認までで安全停止（MF実送信は行わない）。
MF_API_BASE=

# ---------------- 任意 ----------------
NODE_ENV=development
