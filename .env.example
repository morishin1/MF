# =====================================================================
# Vercel / ローカル開発の環境変数テンプレート
# 本番値は Vercel の Project Settings → Environment Variables に設定。
# このファイル(.env.example) は GitHub にコミット可。
# 実値ファイル(.env.local) は .gitignore で除外。
# =====================================================================

# ---------------- Supabase ----------------
# Project Settings → API から取得
SUPABASE_URL=https://vuqzsuhwuznclqxxtgfn.supabase.co
SUPABASE_ANON_KEY=eyJ...           # クライアント側でも使うpublishable key（Settings→API の anon public）
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # サーバ専用（RLSをbypass、絶対にクライアントへ出さない）

# ---------------- Anthropic Claude API ----------------
# https://console.anthropic.com/ → API Keys
# 重要: 「学習に使わない/ゼロ保持」設定を有効にしたキー/組織を使用すること
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------- 初期セットアップ（/api/admin/setup 用） ----------------
# ランダムな長い文字列。設定時のみ setup エンドポイントが有効になる。
# 初期投入が終わったら削除して setup を無効化する運用を推奨。
SETUP_SECRET=

# ---------------- MF連携（OAuth2 / 認可コードフロー） ----------------
# MFアプリポータル「アプリ開発」で登録した連携用アプリの値。
MF_CLIENT_ID=396078215245039
MF_CLIENT_SECRET=            # 【必須・秘密】登録画面の Client Secret
MF_APP_SECRET=              # 【必須・秘密】トークン暗号化/state署名の導出元（ランダムな長い文字列を自分で生成）
# 以下は既定値がコードにあるため通常は未設定でOK（変更時のみ上書き）
MF_REDIRECT_URI=https://mf.8grp.co.jp/api/mf/oauth/callback
MF_AUTH_URL=https://api.biz.moneyforward.com/authorize
MF_TOKEN_URL=https://api.biz.moneyforward.com/token
MF_SCOPES=mfc/admin/office.read

# ---------------- MF実送信（Phase3後半・任意） ----------------
# 仕訳作成/試算表APIのベースURL。仕様確定後に設定して sendViaHttp を有効化。
MF_API_BASE=

# ---------------- Google Drive 保存（証憑の自動保管） ----------------
# サービスアカウントのJSONキー全文を1行で貼る（推奨）。
# 保存先の共有ドライブに、このサービスアカウントを「コンテンツ管理者」で追加しておくこと。
GOOGLE_SERVICE_ACCOUNT_JSON=
# 保存先ルートフォルダのID（例: MF_SYSTEM フォルダ）
GDRIVE_ROOT_FOLDER_ID=1sKb0gwOJiUrZCAu3yux9hnPdt-jn597X

# ---------------- 任意 ----------------
NODE_ENV=development
