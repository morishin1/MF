# マネーフォワード クラウド会計 MCP接続用
# このファイルをコピーして .env.local を作成し、実トークンを入れてください
# .env.local はgit追跡対象外です（.gitignore済）

# MFアプリポータルで発行したアクセストークン
MF_ACCESS_TOKEN=your-access-token-here

# 自社の事業者UUID（MFから初回取得して記録）
MF_OFFICE_UUID=

# 接続先（beta稼働: 2026/4/1〜、alpha稼働: 2026/3/26〜）
MF_MCP_URL=https://beta.mcp.developers.biz.moneyforward.com/mcp/ca/v3
